{
  "name": "@infinitetoken/tsconfig",
  "version": "0.2.0",
  "description": "Shared base tsconfig for InfiniteToken TypeScript packages, with an opt-in tsup build config",
  "keywords": [
    "config",
    "tsconfig",
    "typescript",
    "tsup"
  ],
  "homepage": "https://github.com/infinitetoken/tsconfig#readme",
  "bugs": {
    "url": "https://github.com/infinitetoken/tsconfig/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infinitetoken/tsconfig.git"
  },
  "license": "MIT",
  "author": "Jay Deaton",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": "./tsconfig.json",
    "./node": "./node.json",
    "./package.json": "./package.json",
    "./react-native": "./react-native.json",
    "./server": "./server.json",
    "./tsconfig.json": "./tsconfig.json",
    "./tsup": "./tsup.cjs"
  },
  "files": [
    "tsconfig.json",
    "node.json",
    "react-native.json",
    "server.json",
    "tsup.cjs"
  ],
  "scripts": {
    "fix": "eslint . --fix",
    "lint": "eslint .",
    "release": "git push --follow-tags",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "test": "node scripts/verify-presets.cjs && node scripts/verify-tsup.cjs",
    "verify": "npm run lint && npm test",
    "preversion": "npm run verify"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "devDependencies": {
    "@infinitetoken/eslint-config": "^0.1.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "eslint": "^9.39.4",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "tsup": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "tsup": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
